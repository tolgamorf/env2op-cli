# Double quoted values
DOUBLE_QUOTED="hello world"
DOUBLE_WITH_SPACES="  spaces around  "
DOUBLE_WITH_HASH="value # not a comment"
DOUBLE_EMPTY=""

# Single quoted values
SINGLE_QUOTED='hello world'
SINGLE_WITH_SPACES='  spaces around  '
SINGLE_WITH_HASH='value # not a comment'
SINGLE_EMPTY=''

# Mixed
UNQUOTED=simple_value

# Quotes inside quotes, and inline comments
DOUBLE_WITH_INNER_QUOTES="{"x":1}"
SINGLE_WITH_INNER_QUOTES='it's'
DOUBLE_THEN_QUOTED_COMMENT="a" # say "hi"
EMPTY_WITH_COMMENT=""  # empty on purpose
